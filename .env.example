# Gemini is primary; Ollama is used automatically if Gemini fails.
AI_PROVIDER=gemini
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Server-side Gemini credentials. Never expose these as NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase Auth (server-only; never use NEXT_PUBLIC_ for these values).
SUPABASE_URL=
SUPABASE_ANON_KEY=
